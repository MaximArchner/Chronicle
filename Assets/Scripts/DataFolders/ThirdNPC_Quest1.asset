  m_Script: {fileID: 11500000, guid: fc23288b6d93aab489cf401afc66c4b7, type: 3}
  m_Name: ThirdNPC_Quest1
  m_EditorClassIdentifier: 
  initialDialog:
  - Hey! Guess you're the new guy, I'm Chloe. I can show you the basic of crafting,
    which, in fact, is quite easy! All you have to do is press C and open the Crafting
    System Menu. And you can see different categories of items to craft.
  - With 3 stones and 3 sticks, you can craft an Axe in the Tools section. And you
    can use that axe to chop trees or hunt rabbits. Though, I would ask you not to
    touch the cute rabbits, they're so adorable!
  - 'In order to equip an axe you crafted, open your inventory and right click on
    / drag the axe to the quickslots below your screen. And press the corresponding
    slot number to equip the axe. '
  - 'Can you craft an axe and chop a few trees with the one you created? We could
    use a few logs for the campfire. Bring me 5 and I''ll tell you a secret. '
  acceptOption: Alright, sounds easy. I'm in.
  acceptAnswer: Cool! I'll be waiting here for when you return. I hope the logs won't
    be too heavy though.
  declineOption: I think I need a moment before I do that.
  declineAnswer: Oh well, take your time. It's not that you're supposed to, I guess.
  comebackAfterDecline: Oh, you're back! Have you decided what to do?
  comebackInProgress: Hey, I see you're on the job. Let me know when you have the
    5 Logs.
  comebackCompleted: Awww, you're the best! Our campfire will be brighter than ever!
    Though, I guess it'll take a bit of time for those trees to regrow. Don't tell
    the other XD
  finalWords: 'And as promised, I can tell you: I heard that the lighthouse over
    there could be used to signal the ships around. They are too far to see or hear
    us, but maybe the lighthouse could attract them. But it''s locked at the moment,
    I guess you need to get a key for that.'
  rewardItem1: 
  rewardItem1Amount: 0
  rewardItem2: 
  firstRequirementItem: Log
  firstRequirementAmount: 5
  secondRequirementItem: 
  secondRequirementAmount: 0
